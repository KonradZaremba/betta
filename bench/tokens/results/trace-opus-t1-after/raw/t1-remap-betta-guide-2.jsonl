perParameter(\"Source Min\", DefaultValue = 0.0)] double sourceMin,\n            [GrasshopperParameter(\"Source Max\", DefaultValue = 1.0)] double sourceMax,\n            [GrasshopperParameter(\"Target Min\", DefaultValue = 0.0)] double targetMin,\n            [GrasshopperParameter(\"Target Max\", DefaultValue = 10.0)] double targetMax);\n    }\n\n    public class MyPack : IMyPack\n    {\n        public double Cube(double x) => x * x * x;\n\n        public (double Sum, double Average) Stats(System.Collections.Generic.List<double> numbers)\n        {\n            if (numbers == null || numbers.Count == 0) return (0, 0);\n            double sum = 0;\n            foreach (var n in numbers) sum += n;\n            return (sum, sum / numbers.Count);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":34,"oldLines":5,"newStart":34,"newLines":13,"lines":["             foreach (var n in numbers) sum += n;","             return (sum, sum / numbers.Count);","         }","+","+        public double Remap(double value, double sourceMin, double sourceMax, double targetMin, double targetMax)","+        {","+            double sourceSpan = sourceMax - sourceMin;","+            if (sourceSpan == 0)","+                throw new System.ArgumentException(\"Source Min and Source Max must differ.\");","+            return targetMin + (value - sourceMin) / sourceSpan * (targetMax - targetMin);","+        }","     }"," }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_012iP9jo4z2pDo1KG6yeDq8S","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
