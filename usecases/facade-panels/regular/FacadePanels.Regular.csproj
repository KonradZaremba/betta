<Project Sdk="Microsoft.NET.Sdk">

  <!-- The facade library as hand-written Grasshopper components. Copy bin\...\FacadePanels.Regular.gha
       to %AppData%\Grasshopper\Libraries\ to use it. -->
  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>disable</Nullable>
    <TargetExt>.gha</TargetExt>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="[8.0,8.27)" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

</Project>