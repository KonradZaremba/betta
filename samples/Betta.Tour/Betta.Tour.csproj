<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>11</LangVersion>
    <AssemblyName>Betta.Tour</AssemblyName>
    <RootNamespace>Betta.Tour</RootNamespace>
    <!-- RhinoCommon ships as a net48 package; quiet the cross-TFM warning. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!--
    Betta.Abstractions and Betta.Preview are PROJECT references (Private=false,
    ExcludeAssets=runtime), like Betta.Files and Betta.OpaqueDemo, so the tour
    always builds against the SDK in this repo; it used to consume a local
    0.4.0 package and fell behind. RhinoCommon is referenced compile-only
    because Rhino provides it at load time: the plugin DLL ships neither
    RhinoCommon nor the Betta assemblies. A real plugin uses the packages.

        dotnet build samples/Betta.Tour/Betta.Tour.csproj   (deploys to Libraries\Betta)
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Betta.Abstractions\Betta.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- Preview hook used by TourFeatures only; opt-in, so plugins that don't
         draw in the viewport don't need it. -->
    <ProjectReference Include="..\..\Betta.Preview\Betta.Preview.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <PackageReference Include="RhinoCommon" Version="[8.0,8.27)" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="[8.0,8.27)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Custom icon for the "Slow Square" component (level 6). Matched by name
       suffix, so the namespace prefix on the logical name is irrelevant. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\media\NBTabBetta_Cosmic.png"
                      LogicalName="Betta.Tour.Resources.tour_async.png" />
  </ItemGroup>

  <PropertyGroup>
    <PostBuildEvent>
      xcopy /Q/Y "$(TargetDir)Betta.Tour.dll" "%25AppData%25\Grasshopper\Libraries\Betta\" &amp; exit /b 0
    </PostBuildEvent>
  </PropertyGroup>

</Project>
