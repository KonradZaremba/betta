<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>11</LangVersion>
    <Version>0.7.0</Version>

    <AssemblyName>Betta</AssemblyName>
    <RootNamespace>Betta</RootNamespace>
    <Title>Betta</Title>
    <Description>Same silhouette. Every fish is its own. Runtime adaptation for Grasshopper.</Description>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Betta.Abstractions\Betta.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mini bettas: bold, cartoon-style silhouettes designed to scale cleanly
         to icon sizes. Six color variants form the default rotation. The
         legacy painted bettas (NBTabBetta_*.png) stay in media/ as artwork
         but are not currently embedded. -->
    <EmbeddedResource Include="..\media\NBTabBettaMini_Amber.png"  LogicalName="Betta.Resources.Fish_Amber.png" />
    <EmbeddedResource Include="..\media\NBTabBettaMini_Aqua.png"   LogicalName="Betta.Resources.Fish_Aqua.png" />
    <EmbeddedResource Include="..\media\NBTabBettaMini_Cosmic.png" LogicalName="Betta.Resources.Fish_Cosmic.png" />
    <EmbeddedResource Include="..\media\NBTabBettaMini_Forest.png" LogicalName="Betta.Resources.Fish_Forest.png" />
    <EmbeddedResource Include="..\media\NBTabBettaMini_Lime.png"   LogicalName="Betta.Resources.Fish_Lime.png" />
    <EmbeddedResource Include="..\media\NBTabBettaMini_Rose.png"   LogicalName="Betta.Resources.Fish_Rose.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="[8.0,8.27)" IncludeAssets="compile;build" />
    <!-- Reflection-only plugin-vs-dependency classification (PluginClassifier) so dependency
         DLLs are never byte-loaded into a collectible ALC. netstandard2.0 pkg → loads on net7. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup Condition="$(Configuration) == 'Debug' AND $([MSBuild]::IsOSPlatform(Windows))">
    <StartProgram>C:\Program Files\Rhino 8\System\Rhino.exe</StartProgram>
    <StartArguments></StartArguments>
    <StartAction>Program</StartAction>
  </PropertyGroup>

  <!--
    Grasshopper loads plugins named *.gha, but the compiler must emit a plain
    *.dll: with <TargetExt>.gha</TargetExt> the assembly is written into every
    referencing project's deps.json as "Betta.gha", and hostpolicy rejects a
    non-.dll entry in TRUSTED_PLATFORM_ASSEMBLIES — which killed the test host
    with "Failed to create CoreCLR, HRESULT: 0x80070057" (E_INVALIDARG).

    So Betta.gha is produced as a *copy* of Betta.dll. It runs after
    CopyFilesToOutputDirectory (when TargetPath lands in TargetDir) and before
    the deploy target below, which consumes it.
  -->
  <Target Name="_BettaWriteGha" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName).gha" />
  </Target>

  <!--
    Deploy to the Grasshopper Libraries folder. ContinueOnError mirrors the old
    "exit /b 0": a file lock (Rhino holding the previous copy) leaves the
    deployed copy stale rather than failing the build.

    Betta.dll is excluded deliberately — it is the same assembly identity as
    Betta.gha, and shipping both makes Grasshopper load the plugin twice.
  -->
  <Target Name="_BettaDeployToLibraries"
          AfterTargets="_BettaWriteGha"
          Condition="$([MSBuild]::IsOSPlatform(Windows))">
    <PropertyGroup>
      <_BettaLibrariesDir>$([System.Environment]::GetFolderPath(SpecialFolder.ApplicationData))\Grasshopper\Libraries</_BettaLibrariesDir>
    </PropertyGroup>
    <ItemGroup>
      <_BettaDeployFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(AssemblyName).dll" />
      <_BettaDeployFiles Include="$(TargetDir)$(AssemblyName).gha" />
    </ItemGroup>
    <Copy SourceFiles="@(_BettaDeployFiles)"
          DestinationFolder="$(_BettaLibrariesDir)"
          ContinueOnError="true" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)..\Betta.Build.targets" Condition="Exists('$(MSBuildThisFileDirectory)..\Betta.Build.targets')" />
</Project>
