ry \"Bench\", subcategory \"Data\" through `[GrasshopperCollection]` on `IAsyncStatsPack`, the same interface-plus-class layout as `Collection.cs`.\n\nChoices I made that you may want to change:\n- **Off the UI thread:** the work runs in `Task.Run`, and the input list is copied first so later changes can't race with it.\n- **Cancellation:** the loop checks the token on every item, so a superseded computation stops early.\n- **Standard deviation:** population (divide by n), not sample (n−1). Mean and standard deviation are computed in one pass with Welford's algorithm.\n- **Empty or null input:** returns `(0, 0)`, matching how `Stats` in `Collection.cs` handles empty lists.\n\nI only verified the build. I haven't loaded the plugin in Grasshopper to check that the component appears and cancels on input changes.","ttft_ms":1844,"type":"result","duration_ms":21746,"uuid":"aa72e123-56be-49c2-ab6e-d336058194ed","ttft_stream_ms":1597,"time_to_request_ms":218,"time_to_request_phases_ms":{"other":3,"system_prompt":60,"resume_other":0,"process_user_input":2,"input_attachments":17,"input_hooks":2,"conversation_append":0,"tool_pool_refresh":3,"init_message":73,"init_frame_send":3,"engine_pickup":1,"loop_entry":5,"message_prep":1,"model_config_wait":2,"autocompact":2,"request_announcements":6,"query_setup":1,"model_gates":0,"tool_schema_build":18,"message_normalization":2,"client_creation":11,"request_build":6},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":155,"time_to_request_cpu_ms":343,"time_to_request_major_faults":11895,"input_attachments_detail":{"slowest_producer":"skill_listing","slowest_producer_ms":6,"cpu_ms":31,"major_faults":993,"setup_ms":3,"prompt_producers_ms":0,"ambient_start_ms":5,"ambient_wait_ms":5,"render_ms":1,"producers":43,"token_counts":0},"tool_schema_build_detail":{"betas_ms":0,"waits_ms":1,"placement_ms":0,"render_ms":17,"after_ms":0,"other_ms":0,"tools":15,"new_schemas":15},"message_normalization_detail":{"before