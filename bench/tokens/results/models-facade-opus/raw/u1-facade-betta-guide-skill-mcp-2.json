hat follow the surface.\n- **Shelf height:** a shelf grows to fit its tallest part, which matters when a turned part is taller than the first part on that shelf.\n- **Panels too big for any sheet:** they are left out and counted in the warning; no sheet is opened for them.\n- **Extra errors:** a missing (null) panel in a list, a negative tolerance or spacing, or a sheet size of zero or less shows an error.\n- **CSV:** written with \".\" as the decimal separator whatever the system language. Cut List creates the folder in Path if it doesn't exist.","ttft_ms":5435,"type":"result","duration_ms":137560,"uuid":"0b67c118-f13d-4071-b0bd-497f2271a75c","ttft_stream_ms":5079,"time_to_request_ms":411,"time_to_request_phases_ms":{"other":10,"system_prompt":117,"resume_other":0,"process_user_input":8,"input_attachments":30,"input_hooks":5,"conversation_append":0,"tool_pool_refresh":9,"init_message":67,"init_frame_send":9,"engine_pickup":2,"loop_entry":13,"message_prep":12,"model_config_wait":6,"autocompact":6,"request_announcements":31,"query_setup":3,"model_gates":1,"tool_schema_build":64,"message_normalization":3,"client_creation":3,"request_build":12},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":132,"time_to_request_cpu_ms":329,"time_to_request_major_faults":3106,"input_attachments_detail":{"slowest_producer":"skill_listing","slowest_producer_ms":7,"cpu_ms":31,"major_faults":405,"setup_ms":7,"prompt_producers_ms":0,"ambient_start_ms":11,"ambient_wait_ms":6,"render_ms":2,"producers":43,"token_counts":0},"tool_schema_build_detail":{"betas_ms":0,"waits_ms":1,"placement_ms":2,"render_ms":61,"after_ms":0,"other_ms":0,"tools":15,"new_schemas":15},"message_normalization_detail":{"before_ms":0,"normalize_ms":3,"images_ms":0,"post_process_ms":0,"after_ms":0,"other_ms":0,"messages":14,"wire_messages":2},"request_build_detail":{"records_ms":1,"system_ms":2,"headers_ms":1,"cache_break_record_ms":2,"plans_ms":2,"retry_setup_ms":0,"sent_build_ms":3,"