{
  "$schema": "http://json.schemastore.org/template",
  "author": "Konrad Zaremba",
  "classifications": [ "Grasshopper", "Rhino", "Plugin", "Betta" ],
  "name": "Betta plugin — basic",
  "description": "A minimal Betta Grasshopper plugin: one IBettaCollection interface + implementation, ready to drop into %AppData%/Grasshopper/Libraries/Betta/.",
  "identity": "Betta.Templates.Basic",
  "shortName": "bettaplugin-basic",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "MyBettaPlugin",
  "preferNameDirectory": true,
  "symbols": {
    "BettaAbstractionsVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.4.0",
      "replaces": "BETTA_ABSTRACTIONS_VERSION",
      "description": "Version of Betta.Abstractions to reference."
    },
    "Category": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "MyPack",
      "replaces": "MY_BETTA_CATEGORY",
      "description": "Ribbon category for the generated components."
    }
  }
}
