de, and I left the project file alone.\n\nI did not commit anything, since this directory is not a git repository.","ttft_ms":1761,"type":"result","duration_ms":63563,"uuid":"3ec1e17c-3a00-4b4d-aab5-4f4d295eb328","ttft_stream_ms":1723,"time_to_request_ms":467,"time_to_request_phases_ms":{"other":4,"system_prompt":288,"resume_other":0,"process_user_input":2,"input_attachments":27,"input_hooks":3,"conversation_append":0,"tool_pool_refresh":5,"init_message":69,"init_frame_send":3,"engine_pickup":1,"loop_entry":5,"message_prep":1,"model_config_wait":2,"autocompact":2,"request_announcements":6,"query_setup":1,"model_gates":0,"tool_schema_build":24,"message_normalization":3,"client_creation":12,"request_build":9},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":161,"time_to_request_cpu_ms":719,"time_to_request_major_faults":11190,"input_attachments_detail":{"slowest_producer":"skill_listing","slowest_producer_ms":8,"cpu_ms":15,"major_faults":388,"setup_ms":7,"prompt_producers_ms":0,"ambient_start_ms":6,"ambient_wait_ms":8,"render_ms":2,"producers":43,"token_counts":0},"tool_schema_build_detail":{"betas_ms":0,"waits_ms":1,"placement_ms":1,"render_ms":22,"after_ms":0,"other_ms":0,"tools":15,"new_schemas":15},"message_normalization_detail":{"before_ms":0,"normalize_ms":2,"images_ms":0,"post_process_ms":0,"after_ms":0,"other_ms":1,"messages":13,"wire_messages":2},"request_build_detail":{"records_ms":1,"system_ms":1,"headers_ms":0,"cache_break_record_ms":2,"plans_ms":2,"retry_setup_ms":0,"sent_build_ms":2,"record_attempt_ms":1,"other_ms":0,"sent_build_safety_context_ms":0,"sent_build_cache_breakpoints_ms":0,"sent_build_surrogate_scan_ms":1},"first_content_frame_ms":1723,"queued_turn_count":0,"result_index":0,"credential_expires_at":"2026-12-13T02:43:54.939Z"}
