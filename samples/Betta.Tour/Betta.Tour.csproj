<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>11</LangVersion>
    <AssemblyName>Betta.Tour</AssemblyName>
    <RootNamespace>Betta.Tour</RootNamespace>
    <!-- RhinoCommon ships as a net48 package; quiet the cross-TFM warning. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!--
    Consumes Betta.Abstractions as a NuGet PACKAGE (local pack feed), same as
    the other samples. RhinoCommon is referenced compile-only (ExcludeAssets
    "runtime") because Rhino provides it at load time — the plugin DLL ships
    neither RhinoCommon nor Abstractions. Build flow:

        dotnet pack Betta.Abstractions/Betta.Abstractions.csproj -c Release
        dotnet build samples/Betta.Tour/Betta.Tour.csproj

    Intentionally NOT part of Betta/Betta.sln (the solution builds
    Betta.Abstractions as a project, which would shadow the package).
  -->
  <PropertyGroup>
    <RestoreSources>$(RestoreSources);https://api.nuget.org/v3/index.json;$(MSBuildThisFileDirectory)..\..\artifacts</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Betta.Abstractions" Version="0.3.1" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="[8.0,8.27)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Custom icon for the "Slow Square" component (level 6). Matched by name
       suffix, so the namespace prefix on the logical name is irrelevant. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\media\NBTabBetta_Cosmic.png"
                      LogicalName="Betta.Tour.Resources.tour_async.png" />
  </ItemGroup>

  <PropertyGroup>
    <PostBuildEvent>
      xcopy /Q/Y "$(TargetDir)Betta.Tour.dll" "%25AppData%25\Grasshopper\Libraries\Betta\" &amp; exit /b 0
    </PostBuildEvent>
  </PropertyGroup>

</Project>
