<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Betta.Generators</AssemblyName>
    <RootNamespace>Betta.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- NuGet metadata -->
    <PackageId>Betta.Generators</PackageId>
    <Title>Betta source generator</Title>
    <Authors>Konrad Zaremba</Authors>
    <Description>Compile-time Roslyn incremental generator for Betta plugins. Emits a Betta.Generated.BettaPluginBootstrap that Betta's runtime picks up as a fast-path descriptor manifest, skipping the reflection scan on load. Also emits BETTA001/BETTA010 diagnostics for unsupported parameter types and mismatched Name attributes. Optional — Betta's runtime reflection fallback works fine without it.</Description>
    <PackageTags>grasshopper;rhino;betta;source-generator;roslyn</PackageTags>
    <RepositoryUrl>https://github.com/KonradZaremba/betta</RepositoryUrl>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\</PackageOutputPath>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
