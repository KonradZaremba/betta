<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>disable</Nullable>

    <AssemblyName>Betta.Abstractions</AssemblyName>
    <RootNamespace>Betta</RootNamespace>

    <!-- Reproducible build helps with deterministic NuGet output. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Ship XML docs so plugin authors get IntelliSense on the attributes.
         CS1591 (member without a doc comment) is suppressed: those members
         just show no description. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet package metadata -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Betta.Abstractions</PackageId>
    <Title>Betta.Abstractions</Title>
    <Authors>Konrad Zaremba</Authors>
    <Description>Public contract (attributes + marker interface) for authoring Betta plugins: zero-touch Grasshopper components from attributed C# service methods. Same silhouette, every fish is its own.</Description>
    <PackageTags>grasshopper;rhino;dynamo;zerotouch;plugin;betta</PackageTags>
    <RepositoryUrl>https://github.com/KonradZaremba/betta</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/KonradZaremba/betta</PackageProjectUrl>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\media\NBTabBettaMini_Cosmic.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- IBettaModule plugs into Microsoft.Extensions.DependencyInjection's
         IServiceCollection so plugin assemblies can register their own
         services. The Abstractions package targets netstandard2.0, which the
         DI.Abstractions package also supports — no extra transitive cost for
         plugins that don't use the hook. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
  </ItemGroup>

</Project>
