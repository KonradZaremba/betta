p edges. A part is placed as-is before it is turned, and a turned part only goes on if it fits the current shelf or a new one.\n- **Output order:** `Outlines` and `Sheet` are in placement order, which is tallest first. `Unplaced` is sorted by input index.\n- **Utilization:** it is 0 when no sheets are used.\n- **Extra error checks:** sheet width and height must be above zero, and spacing can't be negative. The spec only named part sizes, so these go beyond it.\n- **Warning text:** \"N part(s) did not fit on an empty sheet and were left out.\"\n\nThe build also runs the project's existing post-build step, which copies the DLL into `%AppData%\\Grasshopper\\Libraries\\Betta\\`.","ttft_ms":1793,"type":"result","duration_ms":84244,"uuid":"5caaaae5-91b2-4650-9740-597a26f33685","ttft_stream_ms":1597,"time_to_request_ms":286,"time_to_request_phases_ms":{"other":4,"system_prompt":59,"resume_other":0,"process_user_input":3,"input_attachments":23,"input_hooks":2,"conversation_append":1,"tool_pool_refresh":3,"init_message":106,"init_frame_send":6,"engine_pickup":1,"loop_entry":5,"message_prep":1,"model_config_wait":3,"autocompact":2,"request_announcements":10,"query_setup":2,"model_gates":0,"tool_schema_build":32,"message_normalization":2,"client_creation":15,"request_build":6},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":221,"time_to_request_cpu_ms":421,"time_to_request_major_faults":12057,"input_attachments_detail":{"slowest_producer":"skill_listing","slowest_producer_ms":5,"cpu_ms":46,"major_faults":1016,"setup_ms":3,"prompt_producers_ms":0,"ambient_start_ms":12,"ambient_wait_ms":5,"render_ms":2,"producers":43,"token_counts":0},"tool_schema_build_detail":{"betas_ms":0,"waits_ms":1,"placement_ms":2,"render_ms":28,"after_ms":1,"other_ms":0,"tools":15,"new_schemas":15},"message_normalization_detail":{"before_ms":0,"normalize_ms":2,"images_ms":0,"post_process_ms":0,"after_ms":0,"other_ms":0,"messages":14,"wire_messages":2},"request_build_d