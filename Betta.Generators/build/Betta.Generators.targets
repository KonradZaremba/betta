<Project>
  <ItemGroup Condition="'$(BettaLock)' != 'false'">
    <AdditionalFiles Include="$(BettaLockFile)" Condition="Exists('$(BettaLockFile)')" />
  </ItemGroup>

  <!--
    Appends the components the generator listed in BettaLockPending.g.cs ("// add: <guid> <Type.Method>")
    to betta.lock, creating it on the first build. Lines are only ever added: removing one is the
    author's call (BETTA012 says when).
  -->
  <Target Name="BettaUpdateLock" AfterTargets="CoreCompile"
          Condition="'$(BettaLock)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <Warning Code="BETTA013" Condition="'$(EmitCompilerGeneratedFiles)' != 'true'"
             Text="betta.lock is not updated: Betta.Generators needs EmitCompilerGeneratedFiles=true to read the components it found. Set it, or turn the lock off with BettaLock=false." />

    <PropertyGroup>
      <_BettaLockPending>$(CompilerGeneratedFilesOutputPath)/Betta.Generators/Betta.Generators.BettaComponentGenerator/BettaLockPending.g.cs</_BettaLockPending>
      <!-- GuidLock.PendingPrefix, without its trailing space. -->
      <_BettaLockPrefix>// add:</_BettaLockPrefix>
      <!-- One line per ;-separated part. -->
      <_BettaLockHeader>
        # betta.lock: the GUID of every Grasshopper component this plugin has published. Check it in.;
        # Saved .gh files find components by GUID. The build adds new components here, and warning;
        # BETTA012 flags a line nothing answers to any more: a rename that breaks saved files. Fix it;
        # with FormerNames. Delete a line only for a component removed on purpose, or never released.
      </_BettaLockHeader>
    </PropertyGroup>

    <ReadLinesFromFile File="$(_BettaLockPending)" Condition="'$(EmitCompilerGeneratedFiles)' == 'true' and Exists('$(_BettaLockPending)')">
      <Output TaskParameter="Lines" ItemName="_BettaLockPendingLine" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(BettaLockFile)" Condition="Exists('$(BettaLockFile)')">
      <Output TaskParameter="Lines" ItemName="_BettaLockLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_BettaLockAdd Include="$([System.String]::Copy('%(_BettaLockPendingLine.Identity)').Substring($(_BettaLockPrefix.Length)).Trim())"
                     Condition="$([System.String]::Copy('%(_BettaLockPendingLine.Identity)').StartsWith('$(_BettaLockPrefix)'))" />
      <_BettaLockAdd Remove="@(_BettaLockLine)" />
      <_BettaLockLine Include="$(_BettaLockHeader)" Condition="!Exists('$(BettaLockFile)')" />
    </ItemGroup>

    <WriteLinesToFile File="$(BettaLockFile)" Lines="@(_BettaLockLine);@(_BettaLockAdd)" Overwrite="true"
                      Condition="'@(_BettaLockAdd)' != ''" />
    <Message Importance="high" Condition="'@(_BettaLockAdd)' != ''"
             Text="$(MSBuildProjectName): added @(_BettaLockAdd->Count()) component(s) to $(BettaLockFile)" />
  </Target>
</Project>
